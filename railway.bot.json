{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.bot"
  },
  "deploy": {
    "restartPolicyType": "ALWAYS",
    "sleepApplication": false,
    "preDeployCommand": [
      "node scripts/migrate.mjs"
    ],
    "overlapSeconds": 0
  }
}
