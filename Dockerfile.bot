FROM node:22-alpine
RUN apk add --no-cache ffmpeg ttf-dejavu python3 py3-pip tesseract-ocr tesseract-ocr-data-eng
COPY requirements.audio.txt /tmp/requirements.audio.txt
RUN python3 -m venv /opt/audio && /opt/audio/bin/pip install --no-cache-dir -r /tmp/requirements.audio.txt
ENV PATH="/opt/audio/bin:${PATH}"
WORKDIR /app
COPY package*.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/bot/package.json apps/bot/package.json
COPY packages/core/package.json packages/core/package.json
RUN npm ci --omit=dev
COPY apps/bot apps/bot
COPY packages/core packages/core
COPY scripts scripts
USER node
CMD ["npm", "run", "bot"]
